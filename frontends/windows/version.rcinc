#include "../../shared/version.h"
1 VERSIONINFO
FILEVERSION CAB_FILE_VERSION
PRODUCTVERSION CAB_FILE_VERSION
FILEOS 0x40004
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", CAB_FILE_DESCRIPTION "\0"
      VALUE "FileVersion", CAB_RESOURCE_VERSION "\0"
      VALUE "ProductName", "Archetype Cab Disabler\0"
      VALUE "ProductVersion", CAB_VERSION "\0"
      VALUE "OriginalFilename", CAB_ORIGINAL_FILENAME "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
