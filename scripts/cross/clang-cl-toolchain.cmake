# Optional Windows compiler experiment. The existing MinGW builder is unchanged.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CAB_LLVM_BIN "/workspace/tools/cab-msvc/bin" CACHE PATH "Directory with clang-cl and LLVM tools")
set(CAB_MSVC_SYSROOT "/workspace/tools/cab-msvc/sysroot" CACHE PATH "Private xwin CRT/SDK installation")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CAB_LLVM_BIN CAB_MSVC_SYSROOT)
if(NOT EXISTS "${CAB_MSVC_SYSROOT}/crt/include/vcruntime.h")
  message(FATAL_ERROR "Install the Microsoft CRT/SDK with xwin before using this toolchain")
endif()
foreach(language C CXX)
  set(CMAKE_${language}_COMPILER "${CAB_LLVM_BIN}/clang-cl")
  set(CMAKE_${language}_COMPILER_TARGET x86_64-pc-windows-msvc)
  set(CMAKE_${language}_FLAGS_INIT "/imsvc${CAB_MSVC_SYSROOT}/crt/include /imsvc${CAB_MSVC_SYSROOT}/sdk/include/ucrt /imsvc${CAB_MSVC_SYSROOT}/sdk/include/shared /imsvc${CAB_MSVC_SYSROOT}/sdk/include/um /imsvc${CAB_MSVC_SYSROOT}/sdk/include/winrt")
endforeach()
set(CMAKE_LINKER "${CAB_LLVM_BIN}/lld-link")
set(CMAKE_AR "${CAB_LLVM_BIN}/llvm-lib")
set(CMAKE_RC_COMPILER "${CAB_LLVM_BIN}/llvm-rc")
set(CMAKE_MT "${CAB_LLVM_BIN}/llvm-mt")
# xwin omits nonredistributable debug runtimes by default.
set(CMAKE_TRY_COMPILE_CONFIGURATION MinSizeRel)
set(CMAKE_EXE_LINKER_FLAGS_INIT "/libpath:${CAB_MSVC_SYSROOT}/crt/lib/x86_64 /libpath:${CAB_MSVC_SYSROOT}/sdk/lib/ucrt/x86_64 /libpath:${CAB_MSVC_SYSROOT}/sdk/lib/um/x86_64")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_RC_FLAGS_INIT "/I${CAB_MSVC_SYSROOT}/crt/include /I${CAB_MSVC_SYSROOT}/sdk/include/ucrt /I${CAB_MSVC_SYSROOT}/sdk/include/shared /I${CAB_MSVC_SYSROOT}/sdk/include/um /I${CAB_MSVC_SYSROOT}/sdk/include/winrt")
